
public class Solution extends GuessGame {
    public int guessNumber(int n) {
        long left = 1;
        long right = n;
        while(left <= right){
            int mid = (int) (left + (right - left) / 2);

            int res = guess(mid);
            if(res == 0){
                return mid;
            }else if(res > 0){
                left = mid + 1;
            }else{
                right = mid - 1;
            }
        }
        return -1;
    }
}
